{
  "buildCommand": "echo 'Static site - no build needed'",
  "outputDirectory": "frontend",
  "framework": "other",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/(?!.*\\.(js|css|png|jpg|jpeg|gif|ico|svg|avif|woff|woff2)$).*",
      "dest": "/index.html"
    }
  ]
}

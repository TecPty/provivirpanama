{
  "buildCommand": "echo 'Frontend build complete'",
  "outputDirectory": "frontend",
  "installCommand": "npm install",
  "framework": "other",
  "public": "frontend",
  "functions": {
    "api/**.js": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

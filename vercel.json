{
  "buildCommand": "echo 'Static frontend deployment'",
  "outputDirectory": "frontend",
  "installCommand": "",
  "framework": "other",
  "public": "frontend",
  "env": {
    "VERCEL_DEPLOY": "true"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

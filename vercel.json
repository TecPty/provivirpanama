{
  "buildCommand": "npm run build || true",
  "outputDirectory": "frontend",
  "installCommand": "npm install || true",
  "framework": "other",
  "public": "frontend",
  "env": {
    "VERCEL_DEPLOY": "true"
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

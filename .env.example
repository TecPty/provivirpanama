# ==============================================================================
# ENVIRONMENT VARIABLES - Provivir Panama
# ==============================================================================

# ---------------------------------------------------------------------------
# DEMO en Vercel (usa estas en Vercel Dashboard → Environment Variables)
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Database - MySQL Remoto (GoDaddy)
# IMPORTANTE: Buscar hostname en cPanel → "Remote MySQL" 
DB_HOST=your-remote-mysql-host.secureserver.net
DB_USER=dev_provivir_user
DB_PASSWORD=your_db_password_here
DB_NAME=provivir_db
DB_PORT=3306
DB_SSL=false

# CORS - Permitir múltiples orígenes
CORS_ORIGIN=https://provivir-demo.vercel.app,https://provivirpanama.com,http://localhost:3000

# ------------------------------------------------------------------------------
# PIPEDRIVE CRM (opcional, recomendado para leads)
# ------------------------------------------------------------------------------
# Activa/desactiva sync al CRM (true|false)
PIPEDRIVE_SYNC_ENABLED=true

# Token API de Pipedrive (Settings > Personal preferences > API)
PIPEDRIVE_API_TOKEN=

# Base URL API (normalmente no cambiar)
PIPEDRIVE_BASE_URL=https://api.pipedrive.com/v1

# Routing por área geográfica (recomendado)
# Área Este → Pipeline "Filtro - Este" (pipeline_id=12, stage_id=76)
PIPEDRIVE_PIPELINE_ESTE=
PIPEDRIVE_STAGE_ESTE=
# Área Oeste → Pipeline "Filtro - Oeste" (pipeline_id=13, stage_id=83)
PIPEDRIVE_PIPELINE_OESTE=
PIPEDRIVE_STAGE_OESTE=

# Fallback genérico (si no se usan los de routing por área)
PIPEDRIVE_PIPELINE_ID=
PIPEDRIVE_STAGE_ID=
PIPEDRIVE_OWNER_ID=
PIPEDRIVE_ORG_ID=

# ------------------------------------------------------------------------------
# PRODUCCIÓN en GoDaddy (usar localhost)
# ------------------------------------------------------------------------------
# NODE_ENV=production
# DB_HOST=localhost
# DB_USER=dev_provivir_user
# DB_PASSWORD=your_prod_db_password
# DB_NAME=provivir_db
# DB_PORT=3306
# CORS_ORIGIN=https://provivirpanama.com

# ==============================================================================
# INSTRUCCIONES PARA ENCONTRAR DB_HOST:
# ==============================================================================
# 1. Login a cPanel
# 2. Buscar "Remote MySQL" o "MySQL Remoto"
# 3. El hostname aparece arriba (ejemplo: p3plzcpnl504722.prod.phx3.secureserver.net)
# 4. Si no aparece, usar: localhost (solo funciona desde mismo servidor)
# ==============================================================================
